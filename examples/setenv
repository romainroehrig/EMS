mac=`hostname -s`
mac=`echo ${mac::-1}`

if [ $mac = "belenoslogin" ] ; then

module () 
{ 
    eval `/usr/bin/modulecmd bash $*`
}

INTELONEAPI="intel/oneapi/2023.2"
GCC=gcc/14.1.0
