mac=`hostname -s`
mac=`echo ${mac:0:6}`
cycle=`echo ${1:-37}`
echo "cycle=$cycle"

if [ $mac = "beleno" ] ; then

module () 
{ 
    eval `/usr/bin/modulecmd bash $*`
}
 
  if [ $cycle = "37" ] ; then

    INTEL="intel/2018.5.274"
    PYTHON=python/3.10.12
    module purge                   2>/dev/null
    module load $INTEL             2>/dev/null
    module load $PYTHON            2>/dev/null

  elif [ $cycle = "49" ] ; then

    INTELONEAPI="intel/oneapi/2023.2"
    GCC=gcc/14.1.0
    PYTHON=python/3.10.12
    module purge                   2>/dev/null
    module load $INTELONEAPI       2>/dev/null
    module load $GCC               2>/dev/null
    module load $PYTHON            2>/dev/null

  fi

fi

export PATH=.:__REP_EMS__/apptools:$PATH
export PYTHONPATH=__REP_EMS__:$PYTHONPATH
